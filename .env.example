# Copy this file to `.env` and fill in the values. Git ignores `.env`. Do not
# commit real keys. The deploy script (./deploy.sh) reads these values. You can
# also run `source .env` first, or export the values in your shell.

# RPC endpoints (Alchemy, Infura or your own node). Use any HTTPS JSON-RPC URL.
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/<key>"
MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<key>"

# Etherscan API key for automatic source verification (--verify). One key is
# sufficient for mainnet and Sepolia with Etherscan v2. The key is optional.
# Without the key, the deploy works but does not verify the source
# automatically.
ETHERSCAN_API_KEY="<your-etherscan-api-key>"
